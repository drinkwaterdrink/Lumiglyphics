{
  "name": "lumiglyphics",
  "version": "0.2.0-beta.24",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test --isolate",
    "test:panels": "bun run ./scripts/test-panels-browser.ts",
    "test:settings": "bun run ./scripts/test-settings-browser.ts",
    "test:image-review": "bun run ./scripts/test-image-review-browser.ts",
    "test:image-library": "bun run ./scripts/test-image-library-browser.ts",
    "test:history": "bun run ./scripts/test-history-browser.ts",
    "test:reading": "bun run ./scripts/test-reading-browser.ts",
    "test:dossiers": "bun run ./scripts/test-dossiers-browser.ts",
    "test:mobile-reader": "bun run ./scripts/test-mobile-reader-browser.ts",
    "test:speech": "bun run ./scripts/test-speech-browser.ts",
    "test:speech:stage": "bun run ./scripts/test-speech-stage-browser.ts",
    "test:text-effects": "bun run ./scripts/test-text-effects-browser.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit",
    "verify:bundle": "bun run ./scripts/verify-extension-build.ts",
    "build": "bun run typecheck:build && bun build ./src/backend.ts ./src/frontend.ts --outdir ./dist --target browser --format esm",
    "build:demo": "bun build ./src/demo.ts --outfile ./demo/demo.js --target browser --format esm",
    "serve:demo": "bun run build:demo && bunx serve ./demo -l 4173",
    "verify": "bun run test && bun run typecheck && bun run build",
    "pack:audio": "bun run ./scripts/pack-audio.ts",
    "shots": "bun run ./scripts/shoot-visual-gallery.ts",
    "test:image-styles": "bun run ./scripts/test-image-styles-browser.ts",
    "test:image-templates": "bun run ./scripts/test-image-templates-browser.ts",
    "test:cast": "bun run ./scripts/test-cast-browser.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "bun-types": "^1.4.0",
    "lumiverse-spindle-types": "0.6.23",
    "typescript": "7.0.2"
  }
}
